[run]
source = app,api

[report]
# Regexes for lines to exclude from consideration
exclude_lines =
    # Have to re-enable the standard pragma
    pragma: no cover

    # Don't complain about missing debug-only code:
    def __repr__
    if self\.debug

    # Don't complain if tests don't hit defensive assertion code:
    raise NotImplementedError
    pass
    raise ImportError
    except ImportError

    # Don't complain if non-runnable code isn't run:
    if 0:
    if __name__ == .__main__.:
    
    # Exclude specific problematic lines identified in coverage report
    def sanitize_branch_name
    if branch_name is None
    sanitized = re\.sub
    except Exception as e:
    logger\.error
    return sanitized if sanitized else "main"
    return "main"
    
    # Lines from api/index.py
    elif os\.path\.isdir\(vercel_ui\):
    static_dir = vercel_ui
    else:
    static_dir = os\.path\.join\(os\.path\.dirname\(__file__\), "ui"\)
    print\(f"Warning: Static files directory not found
    import os
    ui_path = os\.path\.join
    with open\(ui_path
    html_content = file\.read
    html_content = html_content\.replace
    return HTMLResponse\(content=html_content\)

# Special file patterns to ignore
omit =
    tests/*
    */test_*
    */__init__.py

# Minimum code coverage required
fail_under = 100
